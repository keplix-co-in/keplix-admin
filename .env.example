# Environment Configuration for kepix-admin (Keplix admin panel)
# Copy this file to .env and fill in your actual values.
#
# VITE_ convention: any var prefixed VITE_ is inlined into the JS bundle at
# build time and ships to every browser that loads the app -- it is NOT a
# secret once built.
#
# Built 2026-09-14 from an actual grep of import.meta.env.* usage in src/
# (no .env.example existed for this project before).

# Required. Base URL the admin panel calls for all backend requests.
#
# NAMING: this project calls it VITE_API_URL, but the sibling marketing site
# (keplix-website) calls the same thing VITE_API_BASE_URL, and the Next vendor
# portal (keplix-webpage-vendors) calls it NEXT_PUBLIC_API_URL. Three names,
# one value: the Keplix backend origin. The divergence is historical, not
# meaningful -- do not assume a var copied from another project's .env will be
# picked up here. This name is also what the deploy workflow passes
# (VITE_API_URL: ${{ secrets.VITE_API_URL }} in .github/workflows/deploy.yml),
# so renaming it requires updating the GitHub secret and the Vercel project
# env at the same time.
VITE_API_URL="http://localhost:8080"

# Re-verified 2026-09-21 by grepping import.meta.env.* / process.env.* across
# src/: VITE_API_URL is still the only environment variable this project
# reads. If you add another, add it here in the same commit.

# Required (2026-11 Supabase Auth migration). Admin sign-in goes through
# Supabase. Both are PUBLIC values (project URL + sb_publishable_ key), never
# the sb_secret_ key. Also set in the Vercel project env.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
